# Plantilla de secretos de Edge Functions.
# Copia este archivo como `supabase/functions/.env` y rellena los valores reales.
# `supabase/functions/.env` está en .gitignore: nunca lo commitees.

# Wompi (sandbox o producción)
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENTS_SECRET=test_events_xxx
WOMPI_ENV=sandbox

# Secreto para invocar expire-payments desde el cron
CRON_SECRET=una-cadena-larga-aleatoria
